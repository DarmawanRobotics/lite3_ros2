<?xml version="1.0"?>
<!--
  Deep Robotics Jueying Lite3.
  Links, joints, meshes, collisions and inertials: Deep Robotics' official model
  (DeepRoboticsLab/deep_robotics_model, Lite3/urdf/Lite3.urdf, BSD-3-Clause, see
  LICENSE.deep_robotics_model), kept with its names so lite3_driver's joint_states fit.
  Sensor positions: Deep Robotics "Motion System" V2.2.1 (1.1.3).
  base_link is the centre of the body (x forward, y left, z up); the official root TORSO hangs
  on it with an identity joint. No link may be called body, odom, map or camera_init: those
  frames belong to FAST-LIO and Molly.

  Arguments:
    camera: rtsp (the robot's own wide-angle front camera) | realsense (D435i) | none
    lidar:  mid360 | robosense | none
-->
<robot name="lite3" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="camera" default="rtsp"/>
  <xacro:arg name="lidar" default="mid360"/>
  <xacro:property name="camera" value="$(arg camera)"/>
  <xacro:property name="lidar" value="$(arg lidar)"/>

  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:property name="MESH" value="package://lite3_description/meshes"/>

  <!-- legs (official model): HipX on the body, HipY 97.35 mm outward, knee 200 mm and foot
       210.12 mm below. The manual (1.1.2) rounds these to 98.5 mm and 210 mm. -->
  <xacro:property name="hip_x" value="0.1745"/>
  <xacro:property name="hip_y" value="0.062"/>
  <xacro:property name="thigh_offset" value="0.09735"/>
  <xacro:property name="thigh_length" value="0.20"/>
  <xacro:property name="shank_length" value="0.21012"/>

  <!-- sensors (manual 1.1.3), relative to base_link -->
  <xacro:property name="imu_xyz" value="0.005 0 0"/>
  <xacro:property name="mid360_xyz" value="0.18678 0 0.12498"/>
  <!-- the Mid-360's IMU in its LiDAR frame; FAST-LIO extrinsic_T is the negative -->
  <xacro:property name="mid360_imu_xyz" value="0.011 0.02329 -0.04412"/>
  <xacro:property name="robosense_xyz" value="0.2033 0 0.12906"/>
  <xacro:property name="realsense_xyz" value="0.25228 -0.0005 0.0741"/>
  <!-- ESTIMATES, measure them: the built-in wide-angle front camera and the ultrasound pair -->
  <xacro:property name="front_camera_xyz" value="0.280 0 0.0"/>
  <xacro:property name="ultrasound_front_xyz" value="0.285 0 -0.03"/>
  <xacro:property name="ultrasound_rear_xyz" value="-0.285 0 -0.03"/>

  <material name="lite3_body"><color rgba="0.92 0.92 0.92 1.0"/></material>
  <material name="lite3_leg"><color rgba="0.25 0.25 0.27 1.0"/></material>
  <material name="lite3_shank"><color rgba="1.0 1.0 1.0 1.0"/></material>
  <material name="lite3_sensor"><color rgba="0.10 0.10 0.12 1.0"/></material>

  <link name="base_link"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="TORSO"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="TORSO">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.6056"/>
      <inertia ixx="0.02456" ixy="0" ixz="0" iyy="0.05518" iyz="0" izz="0.07016"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${MESH}/torso.STL"/></geometry>
      <material name="lite3_body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.5 0.1 0.12"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><box size="0.25 0.2 0.12"/></geometry>
    </collision>
  </link>

  <!--
    One leg as in the official model. front, left: 1 | -1. The model mirrors one hip and one
    thigh mesh by scale and carries per-leg centres of mass; they are passed through unchanged.
  -->
  <xacro:macro name="leg" params="prefix front left hip_com hip_ixx hip_izz hip_scale
                                  thigh_com thigh_scale shank_com">
    <link name="${prefix}_HIP">
      <inertial>
        <origin xyz="${hip_com}" rpy="0 0 0"/>
        <mass value="0.550"/>
        <inertia ixx="${hip_ixx}" ixy="0" ixz="0" iyy="0.0004028" iyz="0" izz="${hip_izz}"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${MESH}/hip.STL" scale="${hip_scale}"/></geometry>
        <material name="lite3_leg"/>
      </visual>
      <collision>
        <origin xyz="0 ${left * 0.05} 0" rpy="1.57079632 0 0"/>
        <geometry><cylinder length="0.15" radius="0.04"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_HipX_joint" type="revolute">
      <origin xyz="${front * hip_x} ${left * hip_y} 0" rpy="0 0 0"/>
      <parent link="TORSO"/>
      <child link="${prefix}_HIP"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-0.523" upper="0.523" effort="24" velocity="26.2"/>
    </joint>

    <link name="${prefix}_THIGH">
      <inertial>
        <origin xyz="${thigh_com}" rpy="0 0 0"/>
        <mass value="0.86"/>
        <inertia ixx="0.005736" ixy="0" ixz="0" iyy="0.004960" iyz="0" izz="0.001436"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${MESH}/thigh.STL" scale="${thigh_scale}"/></geometry>
        <material name="lite3_leg"/>
      </visual>
      <collision>
        <origin xyz="-0.015 0 -0.08" rpy="0 0 0"/>
        <geometry><box size="0.04 0.045 0.2"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_HipY_joint" type="revolute">
      <origin xyz="0 ${left * thigh_offset} 0" rpy="0 0 0"/>
      <parent link="${prefix}_HIP"/>
      <child link="${prefix}_THIGH"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-2.67" upper="0.314" effort="24" velocity="26.2"/>
    </joint>

    <link name="${prefix}_SHANK">
      <inertial>
        <origin xyz="${shank_com}" rpy="0 0 0"/>
        <mass value="0.153"/>
        <inertia ixx="0.00089039" ixy="0" ixz="0" iyy="0.00090672" iyz="0" izz="3.1266E-05"/>
      </inertial>
      <visual>
        <geometry><mesh filename="${MESH}/shank.STL"/></geometry>
        <material name="lite3_shank"/>
      </visual>
      <collision>
        <origin xyz="0.005 0 -0.03" rpy="0 -0.2 0"/>
        <geometry><cylinder length="0.12" radius="0.015"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.01 0 -0.14" rpy="0 0.15 0"/>
        <geometry><cylinder length="0.10" radius="0.015"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_Knee_joint" type="revolute">
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <parent link="${prefix}_THIGH"/>
      <child link="${prefix}_SHANK"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.524" upper="2.792" effort="36" velocity="17.3"/>
    </joint>

    <link name="${prefix}_FOOT">
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
      </inertial>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry><sphere radius="0.022"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_Ankle" type="fixed">
      <origin xyz="0 0 ${-shank_length}" rpy="0 0 0"/>
      <parent link="${prefix}_SHANK"/>
      <child link="${prefix}_FOOT"/>
    </joint>
  </xacro:macro>

  <xacro:leg prefix="FL" front="1" left="1"
             hip_com="-0.00601 -0.0066532 0.00034295" hip_ixx="0.0003949" hip_izz="0.0004472"
             hip_scale="1 1 1" thigh_com="-0.0039245 -0.014632 -0.025146" thigh_scale="1 1 1"
             shank_com="0.0064794 -1.4535E-06 -0.12157"/>
  <xacro:leg prefix="FR" front="1" left="-1"
             hip_com="-0.010579 0.011358 0.00048546" hip_ixx="0.0004472" hip_izz="0.0003949"
             hip_scale="1 -1 1" thigh_com="-0.0039245 0.014632 -0.025146" thigh_scale="1 -1 1"
             shank_com="0.0064794 -1.4552E-06 -0.12157"/>
  <xacro:leg prefix="HL" front="-1" left="1"
             hip_com="0.010905 -0.012636 0.001051" hip_ixx="0.0003949" hip_izz="0.0004472"
             hip_scale="-1 1 1" thigh_com="-0.0039245 -0.014632 -0.025146" thigh_scale="1 1 1"
             shank_com="0.0064794 -1.4558E-06 -0.12157"/>
  <xacro:leg prefix="HR" front="-1" left="-1"
             hip_com="0.010354 0.011423 0.00049498" hip_ixx="0.0004472" hip_izz="0.0003949"
             hip_scale="-1 -1 1" thigh_com="-0.0039245 0.014632 -0.025146" thigh_scale="1 -1 1"
             shank_com="0.0064794 -1.4529E-06 -0.12157"/>

  <!-- IMU of the motion host -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- ultrasound pair (driver: ultrasound/front, ultrasound/rear) -->
  <joint name="ultrasound_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasound_front"/>
    <origin xyz="${ultrasound_front_xyz}" rpy="0 0 0"/>
  </joint>
  <link name="ultrasound_front"/>
  <joint name="ultrasound_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasound_rear"/>
    <origin xyz="${ultrasound_rear_xyz}" rpy="0 0 ${PI}"/>
  </joint>
  <link name="ultrasound_rear"/>

  <!-- Livox Mid-360: livox_frame is the point cloud origin, livox_imu_frame FAST-LIO's body -->
  <xacro:if value="${lidar == 'mid360'}">
    <joint name="livox_joint" type="fixed">
      <parent link="base_link"/>
      <child link="livox_frame"/>
      <origin xyz="${mid360_xyz}" rpy="0 0 0"/>
    </joint>
    <link name="livox_frame">
      <visual>
        <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0325" length="0.06"/></geometry>
        <material name="lite3_sensor"/>
      </visual>
    </link>
    <joint name="livox_imu_joint" type="fixed">
      <parent link="livox_frame"/>
      <child link="livox_imu_frame"/>
      <origin xyz="${mid360_imu_xyz}" rpy="0 0 0"/>
    </joint>
    <link name="livox_imu_frame"/>
  </xacro:if>

  <!-- RoboSense LiDAR of the LiDAR edition (rslidar_sdk publishes in rslidar) -->
  <xacro:if value="${lidar == 'robosense'}">
    <joint name="rslidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rslidar"/>
      <origin xyz="${robosense_xyz}" rpy="0 0 0"/>
    </joint>
    <link name="rslidar">
      <visual>
        <origin xyz="0 0 -0.03" rpy="0 0 0"/>
        <geometry><cylinder radius="0.05" length="0.07"/></geometry>
        <material name="lite3_sensor"/>
      </visual>
    </link>
  </xacro:if>

  <!-- the robot's own wide-angle camera (RTSP, lite3_camera publishes in the optical frame) -->
  <xacro:if value="${camera == 'rtsp'}">
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${front_camera_xyz}" rpy="0 0 0"/>
    </joint>
    <link name="camera_link">
      <visual>
        <origin xyz="-0.01 0 0" rpy="0 ${PI / 2} 0"/>
        <geometry><cylinder radius="0.018" length="0.02"/></geometry>
        <material name="lite3_sensor"/>
      </visual>
    </link>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-PI / 2} 0 ${-PI / 2}"/>
    </joint>
    <link name="camera_color_optical_frame"/>
  </xacro:if>

  <!-- Intel RealSense D435i: realsense2_camera publishes camera_link -> optical frames -->
  <xacro:if value="${camera == 'realsense'}">
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${realsense_xyz}" rpy="0 0 0"/>
    </joint>
    <link name="camera_link">
      <visual>
        <origin xyz="-0.0125 0.0175 0" rpy="0 0 0"/>
        <geometry><box size="0.025 0.09 0.025"/></geometry>
        <material name="lite3_sensor"/>
      </visual>
    </link>
  </xacro:if>
</robot>
